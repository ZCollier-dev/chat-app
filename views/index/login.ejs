<%- include('../partials/header', { title: "Login" }) %>
<link rel="stylesheet" href="/styles.css">

<div class="main-content">
    <h1>Log In</h1>

    <% if (errorMessage) { %>
        <p class="error-message"><%= errorMessage %></p>
    <% } %>

    <form action="/login" method="post" style="width: 300px">
        <div class="form-input-container">
            <label for="username">Username:</label>
            <input type="text" id="username" name="username" required />
        </div>

        <div class="form-input-container">
            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required />
        </div>

        <button type="submit" class="action-button full-width">Log In</button>
    </form>

    <p style="font-size: 16px; margin-top: 30px">
        Don't have an account? <a href="/signup" class="register-link">Sign Up!</a>
    </p>
</div>

<%- include('../partials/footer') %>
