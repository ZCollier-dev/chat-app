<%- include('../partials/header', { title: "Chat" }) %>
<link rel="stylesheet" href="/styles.css" />

<div class="main-content">
	<h1>Welcome to the Chat, <%= username %>!</h1>

	<div id="chat-box"></div>

	<form id="chat-form">
		<input
			type="text"
			id="message-input"
			placeholder="Type your message..."
			required
		/>
		<button type="submit">Send</button>
	</form>
</div>

<ul id="context-menu" class="context-menu">
	<li onclick="viewProfile()">View Profile</li>
	<% if (user.role === 'admin') { %>
	<li onclick="banUser()">Ban User</li>
	<% } %>
</ul>

<script src="/frontend.js" type="application/javascript"></script>

<%- include('../partials/footer') %>
