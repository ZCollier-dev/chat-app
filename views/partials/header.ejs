<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="stylesheet" href="/styles.css" />
	</head>
	<body>
		<nav class="nav-bar">
			<% if (typeof user !== 'undefined') { %>
			<a href="/chat"><button class="nav-item">Chat</button></a>
			<a href="/profile"><button class="nav-item">Profile</button></a>
			<% if (user.role === 'admin') { %>
			<a href="/admin"><button class="nav-item">Admin Dashboard</button></a>
			<% } %>
			<form action="/logout" method="POST" style="display: inline">
				<button class="nav-item logout" type="submit">Logout</button>
			</form>
			<% } else { %>
			<a href="/login"><button class="nav-item">Login</button></a>
			<a href="/signup"><button class="nav-item">Sign Up</button></a>
			<% } %>
		</nav>
